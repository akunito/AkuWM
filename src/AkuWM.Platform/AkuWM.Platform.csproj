<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that touches Win32, COM and DWM. Targets net8.0-windows and
       builds anywhere; it only *runs* on Windows. -->
  <PropertyGroup>
    <!-- Windows 10 2004 is the floor: that is where the display-configuration
         and cloak APIs AkuWM needs are all present. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AkuWM.Platform</RootNamespace>
    <!-- The whole point of building from WSL: a Windows-targeted assembly is
         produced on Linux. It cannot run there, which is what AkuWM.Core being
         platform-free is for. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- x64 only, and said out loud: half the window APIs (GetWindowLongPtr,
         the pointer-sized styles) have no AnyCPU form, and AkuWM ships a
         win-x64 binary anyway. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- CsWin32 generates the P/Invoke signatures from Microsoft's own Win32
         metadata, so the declarations are neither hand-copied nor guessed.
         What it generates is listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AkuWM.Core/AkuWM.Core.csproj" />
  </ItemGroup>

</Project>
