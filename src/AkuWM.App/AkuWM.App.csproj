<Project Sdk="Microsoft.NET.Sdk">

  <!-- The host: the daemon (pipe server, the platform layer, and from M2 the
       WebSocket server on 6123) plus every command that can be answered
       without one.

       Windows-targeted since M1: it references AkuWM.Platform. The pure
       projects stay platform-free, which is where the logic lives and where
       the unit tests run — on Linux. The binary is still produced from WSL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AkuWM.App</RootNamespace>
    <AssemblyName>akuwm</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Declares uiAccess and PerMonitorV2 DPI. See the manifest for why.
         A uiAccess binary only starts when it is signed AND in a secure
         directory, so a build that is going to be run from the output folder
         has to say -p:UiAccess=false. -->
    <UiAccess Condition="'$(UiAccess)' == ''">true</UiAccess>
    <ApplicationManifest Condition="'$(UiAccess)' == 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UiAccess)' != 'true'">app-dev.manifest</ApplicationManifest>
    <!-- The two builds must not share intermediate output. Choosing a
         different manifest changes no file's timestamp, so MSBuild happily
         considers obj up to date and reuses the executable built with the
         other one — which is how a binary with uiAccess="false" ended up
         installed in Program Files and quietly refused every chord over a
         game. Giving each its own obj makes that impossible rather than
         something to remember. -->
    <IntermediateOutputPath>obj\$(Configuration)\uiaccess-$(UiAccess)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AkuWM.Core/AkuWM.Core.csproj" />
    <ProjectReference Include="../AkuWM.Cli/AkuWM.Cli.csproj" />
    <ProjectReference Include="../AkuWM.Platform/AkuWM.Platform.csproj" />
  </ItemGroup>

</Project>
