<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window's tests: view logic against a fake daemon and a temporary
       config directory, and Avalonia.Headless for the panels themselves.
       xunit v3, because Avalonia 12's headless runner is built on it; the
       Core suite stays on v2 and the two never share a project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AkuWM.Gui.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AkuWM.Gui/AkuWM.Gui.csproj" />
  </ItemGroup>

</Project>
